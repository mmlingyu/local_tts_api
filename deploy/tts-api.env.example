# 示例。不要把填了 token 的文件提交进 git。
# 当前 HTTP 进程还没有读取这些变量。Phonon 目录只被 phonon/linux_runtime.py 读取。

TTS_BIND=127.0.0.1
TTS_PORT=8800
# 留空表示只允许本进程端口和 8787。不要写成 *。
# 用户机器上曾经额外允许 8133，那次改动在未提交的 server.py 里，这里不默认打开。
# TTS_EXTRA_ORIGINS=http://127.0.0.1:8133,http://localhost:8133
# 只有以后经本机反向代理对外时才填写。填写后必须有至少 16 个字符的 token。
TTS_PUBLIC_BASE=
TTS_API_TOKEN=

PIPER_DEVICE=cpu
# 日语 ja_JP-hi_fi_captain-medium 需要单独安装 piper-zh-service/requirements-ja.txt。

PHONON_PTTS=/opt/local-tts-api/phonon/runtime/ptts-0.7.0-x86_64-unknown-linux-gnu/ptts
PHONON_MODEL_DIR=/opt/local-tts-api/phonon/models/phonon-31m-en
PHONON_VOICES_DIR=/opt/local-tts-api/phonon/voices
PHONON_VOICE_CATALOG=/opt/local-tts-api/phonon/voices/voices.jsonl
PHONON_CACHE_DIR=/opt/local-tts-api/phonon/cache
# 目标机 4 个 vCPU、大约 3GiB 可用内存。请求不能改这个值。
PHONON_THREADS=2

POCKET_VARIANT=english_18m_2026-10
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
