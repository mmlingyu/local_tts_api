# 草稿。仓库不会把这个单元装到系统里。
# server.py 的未提交覆盖层还没到，Phonon 也还没接进 POST /api/tts。
# 在那之前不要 enable 这个单元。
# 它只描述以后的本机回环进程，不管理 3080 上的 DeepSeek，也不管理 8080 上的 Caddy。

[Unit]
Description=Local TTS API draft (loopback only, not installed)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/local-tts-api/piper-zh-service
EnvironmentFile=-/etc/local-tts-api.env
ExecStart=/opt/local-tts-api/piper-zh-service/.venv/bin/python -m piper_zh --host 127.0.0.1 --port 8800 --device cpu
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
# 目标机器大约 3.6GiB 内存。这个上限是为了避免 TTS 把整机吃满。
# 它不是测出来的推理峰值。模型还没在这台机器上加载过。
MemoryMax=2G
CPUQuota=350%

[Install]
WantedBy=multi-user.target
